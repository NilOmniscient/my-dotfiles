Window "bar" {
  monitor = 0 
  geometry = {
    x = "0%"
    y = "32px"
    width = "100%"
    height = "30px"
    anchor = "top center"
  }
  exclusive = true
  reserve = {
    distance = "32px"
    side = "top"
  }

  Box {
    orientation = "horizontal"
    halign = "fill"

    LeftWidgets {}
    CenterWidgets {}
    RightWidgets {}
  }
}

Poll "active_window" {
  initial = ""
  interval = "2s"
  cmd = "xdotool getactivewindow getwindowclassname"
}

Listen "now_playing" {
  initial = "Now Playing"
  cmd = "playerctl metadata title"
}

component LeftWidgets () {
  Box {
    orientation = "horizontal"
    halign = "start"
    Label {
      text = global("active_window")
    }
    Label {
      text = global("now_playing").template("󰝚 {now_playing}") 
    }
  }
}

Poll "time" {
  interval = "10s"
  cmd = "date '+%I:%M %p'"
  initial = ""
}

component CenterWidgets () {
  Box {
    orientation = "horizontal"
    halign = "center"
    hexpand = true

    Label {
      text = "󰂚"
    }
    Label  {
      text = global("time").template(" {time}")
    }
  }
}

component RightWidgets () {
  Box {
    orientation = "horizontal"
    halign = "end"
    Label {
      text = "controls"
    }
    Label  {
      text = "systray"
    }
  }
}
