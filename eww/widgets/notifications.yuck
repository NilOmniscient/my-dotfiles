(defwindow notifications
  :monitor 0
  :geometry (geometry :x "0%"
    :y "2px"
    :width "40%"
    :height "40%"
    :anchor "top center")
  :stacking "fg"
  :wm-ignore false
  (scroll
    :vscroll true
    :hscroll false
    (box
      :space-evenly false
      :orientation "v"
      (history))))


(defpoll dunst_history :interval "5s"
  "./scripts/dunst_history.sh"
  )
(defwidget history []

  (box
    :class "notifications"
    :orientation "v"
    (for notification in dunst_history
      (box
        :class "notification"
        :orientation "v"
        (eventbox
          :onclick "dunstctl history-rm ${notification.id}"
          (box
            :orientation "v"
            (label :class "notification-header" :text {notification.app})
            (label :class "notification-summary" :text {notification.summary})
            (label :class "notification-body" :text {notification.body})))))))
  
