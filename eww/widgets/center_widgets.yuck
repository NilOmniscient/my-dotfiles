(defwidget center_widgets []
  (box
    :orientation "horizontal"
    :space-evenly false
    :spacing 10
    (eventbox
      :onclick "eww open notifications --toggle"
      :onmiddleclick "dunstctl history-clear"
      :onrightclick "dunstctl set-pause toggle"
      (label 
        :class "widget"
        :halign "center"
        :text dunst_status) 
    )
    (label
      :class "widget"
      :text time)
  )
)

(defpoll time :interval "10s"
  "date '+%I:%M %p'")
(defpoll dunst_status :interval "2s"
  "./scripts/dunst_status.sh")
