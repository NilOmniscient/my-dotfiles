(include "widgets/left_widgets.yuck")
(include "widgets/center_widgets.yuck")
(include "widgets/right_widgets.yuck")
(include "widgets/notifications.yuck")

(defwindow bar 
  :monitor 0
  :geometry (geometry :x "0%"
    :y "2px"
    :width "100%"
    :height "24px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :reserve (struts :distance "40px" :side "top")
  :windowtype "dock"
  :wm-ignore false
  (centerbox :orientation "horizontal"
    (left_widgets)
    (center_widgets)
    (right_widgets)
  )
)
