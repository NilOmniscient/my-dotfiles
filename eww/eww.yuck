(include "./left_widgets.yuck")
(include "./center_widgets.yuck")
(include "./right_widgets.yuck")
(defwindow bar 
  :monitor 0
  :geometry (geometry :x "0%"
    :y "2px"
    :width "100%"
    :height "24px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :reserve (struts :distance "40px" :side "top")
  :windowtype "dock"
  :wm-ignore false
  (centerbox :orientation "horizontal"
    (left_widgets)
    (center_widgets)
    (right_widgets)
  )
)

(defwindow notifications 
  :monitor 0
  :geometry (geometry :x "0%"
    :y "4px"
    :width "40%"
    :height "40%"
    :anchor "top center")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  (label :text "Notification Center")
)

