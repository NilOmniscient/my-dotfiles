(defwidget center_widgets []
  (box
    :orientation "horizontal"
    :halign "center"
    :space-evenly false
    :spacing 10
    (eventbox
      :orientation "horizontal"
      :halign "center"
      :onclick "end-rs history toggle"
      :onmiddleclick "end-rs history clear"
      :onrightclick "end-rs dnd toggle"
      (label :text {(end-histories == '' || end-histories == '(box :space-evenly false :orientation "v" )') ? end_status : " 󱅫 "})
    )
    (label :text time)
  )
)

(defpoll time :interval "10s"
  "date '+%I:%M %p'")
(defpoll end_status :interval "2s"
  "./scripts/end_status.sh")
