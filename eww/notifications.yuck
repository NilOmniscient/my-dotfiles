(defwindow notifications
  :monitor 0
  :geometry (geometry :x "0%"
    :y "2px"
    :width "40%"
    :height "40%"
    :anchor "top center")
  :stacking "fg"
  :wm-ignore false
  (box
    :orientation "v"
    (history)
    )
  )
(defpoll dunst_history :interval "5s"
  "./scripts/dunst_history.sh"
  )
(defwidget history []
  (box
    :class "notification"
    :orientation "v"
    :spacing "20px"
    (for notification in dunst_history
      (box
        :orientation "v"
        :space-evenly false
        :spacing "4px"
        (box
          :orientation "h"
          :spacing "20px"
          :space-evenly false
          (label :text {notification.app})
          (button
            :onclick "dunstctl history-rm ${notification.id}"
            (label :text "Remove")))
        (label :text {notification.summary})
        (label :text {notification.body})))))
  
