(defwidget left_widgets []
  (box
    :orientation "horizontal"
    :space-evenly false
    :spacing 10
    (box
      :orientation "horizontal"
      :space-evenly false
      :spacing 2
      (image
        :icon active_icon)
      (label 
        :halign "start"
        :limit-width: 15
        :show-truncated true
        :text active_window))
    (label 
      :halign "start"
      :truncate true
      :limit-width 29
      :text now_playing)
  )
)
; Attempt to show active window
(defpoll active_icon :interval "1s"
  :initial ""
  `./scripts/active_window_icon.sh`)
(defpoll active_window :interval "1s"
  :initial ""
  `./scripts/active_window.sh`
)
(deflisten now_playing :interval "2s"
  :initial "󰝚 Nothing Playing"
  `playerctl --follow metadata --format '󰝚 {{ title }}'`
)
